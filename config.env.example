# Copy to ~/.config/flipper-subghz-api/config.env, then `chmod 600` it.
# The service refuses to start if this file is group/other readable, if the token is
# missing/short, or if FLIPPER_API_BIND is a wildcard/public address.
# The real file is gitignored (*.env). Never commit or paste the token anywhere.

# Required: >= 32 chars from [A-Za-z0-9._~+/=-], e.g. generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
FLIPPER_API_TOKEN=

# Required: this host's LAN IP (a literal address). 0.0.0.0 / :: / public IPs are refused.
# 192.0.2.10 is a documentation placeholder (RFC 5737): replace it with your own.
FLIPPER_API_BIND=192.0.2.10

# Optional: the allowlist of actions (JSON or TOML). $FLIPPER_ACTIONS_FILE and
# --actions-file override this value.
FLIPPER_ACTIONS_FILE=~/.config/flipper-subghz-api/actions.json

# Optional
FLIPPER_API_PORT=8787
# Prefer the stable by-id name. Find yours with: ls /dev/serial/by-id/
# FLIPPER_SERIAL_PORT=/dev/serial/by-id/usb-Flipper_Devices_Inc._Flipper_<name>_<name>-if00
FLIPPER_SERIAL_PORT=/dev/ttyACM0
FLIPPER_TX_TIMEOUT=30
FLIPPER_MIN_INTERVAL=3
